# Copy to Vercel > Project > Settings > Environment Variables (never commit real values).
# Leave the Supabase ones empty to run in log-only mode.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Extra origins allowed to post leads cross-origin (rgstructures.in is allowed by default).
ALLOWED_ORIGINS=
# Optional: also forward every lead to a webhook (Apps Script, Zapier, CRM).
LEAD_WEBHOOK_URL=
